pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = "851382689538"
        AWS_REGION     = "ap-south-1"
        REPO_NAME      = "devops-app"
        IMAGE_TAG      = "${env.BUILD_NUMBER}"
        REGISTRY_URL   = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        MAVEN_IMAGE    = "maven:3.9.6-eclipse-temurin-17"
    }

    stages {
        stage("Checkout") {
            steps {
                checkout scm
            }
        }

        stage("Test") {
            steps {
                bat """
                    docker run --rm ^
                      -v "%cd%":/workspace ^
                      -w /workspace ^
                      ${MAVEN_IMAGE} ^
                      mvn test
                """
            }
        }

        stage("Build JAR") {
            steps {
                bat """
                    docker run --rm ^
                      -v "%cd%":/workspace ^
                      -w /workspace ^
                      ${MAVEN_IMAGE} ^
                      mvn clean package -DskipTests
                """
                stash name: "jar-file", includes: "target/*.jar"
            }
        }

        stage("Build Docker Image") {
            steps {
                unstash "jar-file"
                bat "docker build -t ${REPO_NAME}:${IMAGE_TAG} ."
            }
        }

        stage("Login to ECR") {
            steps {
                withCredentials([[$class: "AmazonWebServicesCredentialsBinding",
                                  credentialsId: "aws-credentials"]]) {
                    bat """
                        aws ecr get-login-password --region ${AWS_REGION} > ecr_pass.txt
                        docker login --username AWS --password-stdin ${REGISTRY_URL} < ecr_pass.txt
                        del ecr_pass.txt
                    """
                }
            }
        }

        stage("Push to ECR") {
            steps {
                bat """
                    docker tag ${REPO_NAME}:${IMAGE_TAG} ${REGISTRY_URL}/${REPO_NAME}:${IMAGE_TAG}
                    docker push ${REGISTRY_URL}/${REPO_NAME}:${IMAGE_TAG}
                """
            }
        }
    }

    post {
        success {
            echo "CI done! Triggering devops-CD pipeline with tag: ${IMAGE_TAG}"
            build job: 'devops-CD',
                  wait: true,
                  parameters: [string(name: 'BUILD_TAG', value: "${IMAGE_TAG}")]
        }
        failure {
            echo "CI failed. CD pipeline NOT triggered."
        }
    }
}