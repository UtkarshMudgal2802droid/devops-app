pipeline {
    agent any

    parameters {
        string(name: 'BUILD_TAG', defaultValue: 'latest', description: 'Tag received from CI pipeline')
    }

    environment {
        AWS_ACCOUNT_ID = "851382689538"
        AWS_REGION = "ap-south-1"
        REPO_NAME = "devops"
        REGISTRY_URL = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        EC2_HOST = "ec2-16-171-15-80.eu-north-1.compute.amazonaws.com"
        CONTAINER_NAME = "devops-container"
        EC2_USER = "ubuntu"
    }

    stages {
        stage('Login to ECR (Controller)') {
            steps {
                script {
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                        bat "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${REGISTRY_URL}"
                    }
                }
            }
        }

        stage('PULL from ECR & RUN via SSH') {
            steps {
                script {
                    def tag = params.BUILD_TAG

                    withCredentials([file(credentialsId: 'ec2-pem-key', variable: 'PEM_FILE')]) {
                        bat """
                        @echo off
                        icacls "%PEM_FILE%" /reset
                        icacls "%PEM_FILE%" /inheritance:r
                        icacls "%PEM_FILE%" /grant:r *S-1-5-18:(R)
                        icacls "%PEM_FILE%" /grant:r "%USERNAME%":(R)

                        ssh -i "%PEM_FILE%" -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} "aws ecr get-login-password --region ${AWS_REGION} | sudo docker login --username AWS --password-stdin ${REGISTRY_URL} && sudo docker pull ${REGISTRY_URL}/${REPO_NAME}:${tag} && sudo docker rm -f ${CONTAINER_NAME} || true && sudo docker rm -f devops-app || true && sudo docker run -d -p 80:8080 --name ${CONTAINER_NAME} ${REGISTRY_URL}/${REPO_NAME}:${tag}"
                        """
                    }
                }
            }
        }
    }
}