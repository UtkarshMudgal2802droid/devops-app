pipeline {
    agent any

    parameters {
        string(name: "BUILD_TAG",
               defaultValue: "latest",
               description: "Image tag received from CI pipeline")
    }

    environment {
        AWS_ACCOUNT_ID  = "851382689538"
        AWS_REGION      = "ap-south-1"
        REPO_NAME       = "devops"
        REGISTRY_URL    = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        EC2_USER        = "ubuntu"
        EC2_HOST        = "ec2-16-171-15-80.eu-north-1.compute.amazonaws.com"
        CONTAINER_NAME  = "devops-app-container"
    }

    stages {
        stage("Fix PEM Permissions") {
            steps {
                echo "PEM permissions skipped - Windows OpenSSH works without strict icacls"
            }
        }

        stage("Pull Image from ECR on EC2") {
            steps {
                script {
                    def tag = params.BUILD_TAG
                    withCredentials([file(credentialsId: "ec2-pem-key", variable: "PEM_FILE")]) {
                        bat """
                            type nul > "%PEM_FILE%"
                            icacls "%PEM_FILE%" /inheritance:r /grant *S-1-5-18:(R) || true
                            ssh -i "%PEM_FILE%" -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} ^
                            "aws ecr get-login-password --region ${AWS_REGION} | sudo docker login --username AWS --password-stdin ${REGISTRY_URL} && sudo docker pull ${REGISTRY_URL}/${REPO_NAME}:${tag}"
                        """
                    }
                }
            }
        }

        stage("Stop Old Container") {
            steps {
                script {
                    withCredentials([file(credentialsId: "ec2-pem-key", variable: "PEM_FILE")]) {
                        bat """
                            ssh -i "%PEM_FILE%" -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} ^
                            "sudo docker rm -f ${CONTAINER_NAME} 2>/dev/null || true"
                        """
                    }
                }
            }
        }

        stage("Start New Container") {
            steps {
                script {
                    def tag = params.BUILD_TAG
                    withCredentials([file(credentialsId: "ec2-pem-key", variable: "PEM_FILE")]) {
                        bat """
                            ssh -i "%PEM_FILE%" -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} ^
                            "sudo docker run -d -p 80:8080 --name ${CONTAINER_NAME} --restart always ${REGISTRY_URL}/${REPO_NAME}:${tag}"
                        """
                    }
                }
            }
        }

        stage("Verify Deployment") {
            steps {
                script {
                    withCredentials([file(credentialsId: "ec2-pem-key", variable: "PEM_FILE")]) {
                        bat """
                            ssh -i "%PEM_FILE%" -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} ^
                            "sudo docker ps | grep ${CONTAINER_NAME}"
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "App is LIVE at http://${EC2_HOST}"
        }
        failure {
            echo "Deployment failed. Check EC2 SSH or Docker logs."
        }
    }
}